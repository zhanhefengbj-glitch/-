{
  "name": "desktop-pet",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "compress": "node compress.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.zhanh.desktoppet",
    "productName": "我的桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
